#!/usr/bin/env node
// Mechanical evidence checks; no model calls or semantic judgments.
const { readFileSync, writeFileSync, realpathSync } = await import('node:fs');
const { resolve, relative, isAbsolute, join } = await import('node:path');
const run=process.argv[2], root=realpathSync(process.cwd());
const state=JSON.parse(readFileSync(join(run,'state.json'),'utf8')), checks=[];
const check=(source)=>{
  let verified=false,reason='missing local file, line or quote';
  try {
    const file=realpathSync(resolve(root,source.file)), rel=relative(root,file);
    if(isAbsolute(rel) || rel==='..' || rel.startsWith('../'))throw new Error('source outside project');
    const lines=readFileSync(file,'utf8').split(/\r?\n/), end=source.endLine ?? source.line;
    if(!Number.isSafeInteger(source.line) || !Number.isSafeInteger(end) || source.line<1 || end<source.line || end>lines.length)throw new Error('line outside file');
    const excerpt=lines.slice(source.line-1,end).join('\n');
    if(source.quote!==undefined && (typeof source.quote!=='string' || !source.quote || !excerpt.includes(source.quote.replace(/\r\n/g,'\n'))))throw new Error('quote differs from file at claimed lines');
    verified=true;reason=source.quote===undefined?'location exists; meaning unchecked':'exact quote matches';
  }catch(e){reason=e.message;}
  checks.push({...source,status:verified?'verified':'unverified',reason});
};
const scan=(value,step,evidence=[])=>{
  if(typeof value==='string') {
    for(const m of value.matchAll(/(?:^|[\s(`])([\w./-]+):(\d+)(?:-(\d+))?/g))check({step,file:m[1],line:Number(m[2]),...(m[3]?{endLine:Number(m[3])}:{})});
    for(const m of value.matchAll(/“([^”]+)”|"([^"\n]+)"|‘([^’]+)’/g)) {
      const quote=m[1] ?? m[2] ?? m[3];
      if(!evidence.some((s)=>s.quote===quote))checks.push({step,quote,status:'unverified',reason:'quote has no local source declaration'});
    }
    for(const m of value.matchAll(/https?:\/\/[^\s)>]+/g))checks.push({step,url:m[0],status:'unverified',reason:'remote source not checked against local files'});
  } else if(Array.isArray(value))value.forEach((v)=>scan(v,step,evidence));
  else if(value && typeof value==='object') {
    const own=value.evidence ?? [];
    if(!Array.isArray(own))throw new Error('evidence must be an array');
    for(const source of own)check({...source,step});
    for(const [k,v] of Object.entries(value))if(k!=='evidence')scan(v,step,[...evidence,...own]);
  }
};
for(const [step,e] of Object.entries(state.steps))if(e.attempts && e.output)scan(e.output,step);
const result={checks,verified:checks.filter((c)=>c.status==='verified').length,unverified:checks.filter((c)=>c.status==='unverified').length};
writeFileSync(join(run,'verification.json'),JSON.stringify(result,null,2)+'\n');
console.log(JSON.stringify(result,null,2));
