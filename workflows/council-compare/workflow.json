{
  "workflow": 2,
  "description": "Compares options you already have, with research, three independent proposals, anonymous critique and checked quotes, then asks for your choice. Give the question and the options: orchestra run council-compare \"SQLite or Postgres for the local cache?\". Returns decision.md in the run folder; it never edits project files.",
  "budget": {
    "calls": 16
  },
  "steps": [
    {
      "id": "frame",
      "ask": {
        "prompt": "../_shared/frame.md"
      }
    },
    {
      "id": "research",
      "agent": {
        "prompt": "mode.md",
        "tier": 1,
        "access": "read"
      }
    },
    {
      "id": "proposals",
      "parallel": {
        "prompt": "../_shared/propose.md",
        "tier": 3,
        "access": "read",
        "count": 3,
        "distinct": "vendor",
        "sees": [
          "research"
        ]
      }
    },
    {
      "id": "rounds",
      "loop": {
        "max": 2,
        "until": {
          "step": "critique",
          "field": "items.0.stop",
          "equals": true
        },
        "steps": [
          {
            "id": "critique",
            "parallel": {
              "prompt": "../_shared/critique.md",
              "tier": 3,
              "access": "read",
              "count": 3,
              "distinct": "vendor",
              "anonymize": true,
              "sees": [
                "proposals",
                "critique"
              ]
            }
          }
        ]
      }
    },
    {
      "id": "verify",
      "gate": {
        "command": "node \"{{workflowDir}}/../_shared/scripts/verify-quotes\" \"{{runDir}}\""
      }
    },
    {
      "id": "decide",
      "ask": {
        "prompt": "../_shared/decide.md"
      }
    },
    {
      "id": "record",
      "gate": {
        "command": "node \"{{workflowDir}}/../_shared/scripts/record.mjs\" \"{{runDir}}\""
      }
    }
  ]
}
